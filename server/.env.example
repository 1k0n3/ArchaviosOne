# MTGA Stats Website – Konfiguration (Kopie als .env ablegen)
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Öffentliche Adresse (für Links in E-Mails und OAuth-Rückrufe)
BASE_URL=https://mtga.example.de
# Datenverzeichnis (SQLite-Datei, Sitzungsgeheimnis); im Docker-Setup ein Volume
DATA_DIR=/data
# Sitzungsgeheimnis (leer = wird beim ersten Start erzeugt und in DATA_DIR abgelegt)
SESSION_SECRET=
SESSION_DAYS=30
# Hinter Caddy/Nginx: Client-IP aus X-Forwarded-For lesen
TRUST_PROXY=1
# E-Mail-Versand (Bestätigung, Passwort-Reset). Leer = Links nur ins Log schreiben (Entwicklung)
SMTP_URL=smtps://benutzer:passwort@smtp.example.de:465
MAIL_FROM=MTGA Stats <no-reply@mtga.example.de>
# OAuth (optional). Rückruf-Adressen: BASE_URL/auth/discord/callback bzw. BASE_URL/auth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Neue Konten erlauben (0 = geschlossen)
REGISTRATION_OPEN=1
