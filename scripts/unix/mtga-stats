#!/usr/bin/env bash
# Steuerung von MTGA Stats auf macOS/Linux/Steam Deck (auch aus Flatpak und Homebrew heraus):
#   mtga-stats start | stop | restart | run | app | status | dashboard | log | account | update
#   (run: Watcher im Vordergrund · app: dazu das Dashboard öffnen, so startet das Flatpak
#    · update: neuesten Stand laden und neu installieren, Einstellungen und Daten bleiben)
# Einstellungen und Daten: im Tool-Ordner, wenn er beschreibbar ist (ZIP-Installation), sonst unter
# ~/.config/mtga-stats/watch-config.json und ~/.local/share/mtga-stats (Flatpak, Homebrew) – oder MTGA_STATS_CONFIG.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
APP_DIR="${MTGA_STATS_HOME:-$HOME/.mtga-stats}"
PIDFILE="$APP_DIR/watcher.pid"
mkdir -p "$APP_DIR"
NODE="$(cat "$APP_DIR/node-path" 2>/dev/null || command -v node || true)"
[ -n "$NODE" ] && [ -x "$NODE" ] || NODE="$(command -v node || true)"
[ -n "$NODE" ] || { echo "Node.js nicht gefunden – bitte bash install.sh ausführen oder Node.js 22+ installieren." >&2; exit 1; }

# Einstellungsdatei: Umgebungsvariable, sonst Tool-Ordner (wenn beschreibbar), sonst XDG-Konfigordner
if [ -z "${MTGA_STATS_CONFIG:-}" ]; then
  if [ -w "$ROOT" ]; then MTGA_STATS_CONFIG="$ROOT/watch-config.json"; else MTGA_STATS_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/mtga-stats/watch-config.json"; fi
fi
export MTGA_STATS_CONFIG
if [ ! -f "$MTGA_STATS_CONFIG" ]; then
  mkdir -p "$(dirname "$MTGA_STATS_CONFIG")"
  DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/mtga-stats"
  if [ -w "$ROOT" ] && [ "$MTGA_STATS_CONFIG" = "$ROOT/watch-config.json" ]; then DATA_DIR="$ROOT/out"; fi
  printf '{\n  "_hinweis": "Einstellungen von MTGA Stats (siehe watch-config.json im Projekt fuer alle Schluessel)",\n  "outDir": "%s",\n  "webPort": 8765\n}\n' "$DATA_DIR" > "$MTGA_STATS_CONFIG"
fi
PORT="$("$NODE" -e "try{const c=JSON.parse(require('fs').readFileSync(process.env.MTGA_STATS_CONFIG,'utf8').replace(/^﻿/,''));console.log(c.webPort||8765)}catch(e){console.log(8765)}")"
URL="http://localhost:$PORT/"
OS="$(uname -s)"
export MTGA_ROOT="$ROOT"
LOGDIR="$("$NODE" -e "console.log(require(process.env.MTGA_ROOT+'/src/paths.js').outDir())")"

running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }
# Antwortet das Dashboard? Sieht auch einen Watcher aus einer anderen Sandbox (Flatpak), den die PID-Datei nicht kennt
up() { "$NODE" -e "require('http').get(process.argv[1],()=>process.exit(0)).on('error',()=>process.exit(1)).setTimeout(1500,()=>process.exit(1))" "$URL" >/dev/null 2>&1; }
wait_up() { for _ in $(seq 1 "${1:-30}"); do up && return 0; sleep 1; done; return 1; }
managed() {
  if [ "$OS" = "Darwin" ]; then launchctl print "gui/$(id -u)/de.mtga-stats.watcher" >/dev/null 2>&1 || launchctl print "gui/$(id -u)/homebrew.mxcl.mtga-stats" >/dev/null 2>&1
  else systemctl --user is-active --quiet mtga-stats.service 2>/dev/null; fi
}
# Firefox kennt keinen App-Modus. Ein eigenes Profil blendet Tabs, Adress- und Lesezeichenleiste aus,
# es bleibt nur die Titelleiste des Fensters. Anmeldefenster (Popups) behalten ihre Adresszeile.
firefox_profile() {
  local P="$1"; mkdir -p "$P/chrome"
  cat > "$P/user.js" <<'EOF'
// MTGA Stats: Profil für das App-Fenster (wird bei jedem Start neu geschrieben)
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("browser.tabs.inTitlebar", 0);
user_pref("browser.toolbars.bookmarks.visibility", "never");
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("trailhead.firstrun.didSeeAboutWelcome", true);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("startup.homepage_welcome_url", "");
user_pref("startup.homepage_welcome_url.additional", "");
user_pref("browser.startup.upgradeDialog.enabled", false);
user_pref("datareporting.policy.dataSubmissionPolicyBypassNotification", true);
user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.startup.page", 0);
user_pref("browser.tabs.warnOnClose", false);
user_pref("browser.warnOnQuit", false);
user_pref("browser.link.open_newwindow", 2);
user_pref("browser.translations.automaticallyPopup", false);
user_pref("sidebar.revamp", false);
user_pref("sidebar.verticalTabs", false);
user_pref("browser.ml.chat.enabled", false);
user_pref("extensions.pocket.enabled", false);
EOF
  cat > "$P/chrome/userChrome.css" <<'EOF'
/* MTGA Stats: Dashboard als App-Fenster – nur die Titelleiste bleibt. Popups (Anmeldungen) zeigen weiter ihre Adresse. */
:root:not([chromehidden~="toolbar"]) #navigator-toolbox { visibility: collapse !important; }
:root:not([chromehidden~="toolbar"]) #sidebar-main, :root:not([chromehidden~="toolbar"]) #sidebar-box { display: none !important; }
EOF
  # Fenstergröße beim ersten Start; danach merkt sich Firefox die zuletzt benutzte
  [ -f "$P/xulstore.json" ] || printf '{"chrome://browser/content/browser.xhtml":{"main-window":{"width":"1400","height":"900","sizemode":"normal"}}}' > "$P/xulstore.json"
}
# Bildschirm-Umgebung merken: der Watcher läuft oft als Hintergrunddienst ohne sie und braucht sie,
# um Links zu fremden Seiten im normalen Browser zu öffnen (src/serve.js, /api/open-url)
remember_session() {
  local k; : > "$APP_DIR/session.env"
  for k in DISPLAY WAYLAND_DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR XDG_CURRENT_DESKTOP XDG_SESSION_TYPE; do
    [ -n "${!k:-}" ] && printf '%s=%s\n' "$k" "${!k}" >> "$APP_DIR/session.env"
  done
  chmod 600 "$APP_DIR/session.env" 2>/dev/null || true
}
open_url() {
  if [ "$OS" = "Darwin" ]; then
    if [ -d "/Applications/Google Chrome.app" ]; then open -na "Google Chrome" --args --app="$URL" --user-data-dir="$APP_DIR/chrome-profile"; else open "$URL"; fi
    return 0
  fi
  remember_session
  # 1. Chrome, Chromium, Brave, Edge, Vivaldi: echter App-Modus (Fenster ohne Browserleisten)
  local b
  for b in google-chrome google-chrome-stable chromium chromium-browser brave-browser brave microsoft-edge microsoft-edge-stable vivaldi vivaldi-stable; do
    if command -v "$b" >/dev/null 2>&1; then "$b" --app="$URL" --user-data-dir="$APP_DIR/chrome-profile" --window-size=1400,900 --class=mtga-stats --no-first-run --no-default-browser-check >/dev/null 2>&1 & return 0; fi
  done
  # dieselben als Flatpak (Steam Deck: über Discover installiert)
  if command -v flatpak >/dev/null 2>&1; then
    for b in com.google.Chrome org.chromium.Chromium com.brave.Browser com.microsoft.Edge io.github.ungoogled_software.ungoogled_chromium com.vivaldi.Vivaldi; do
      if flatpak info "$b" >/dev/null 2>&1; then flatpak run "$b" --app="$URL" --window-size=1400,900 --class=mtga-stats >/dev/null 2>&1 & return 0; fi
    done
  fi
  # 2. Firefox mit eigenem Profil ohne Leisten (normal installiert oder als Flatpak)
  if command -v firefox >/dev/null 2>&1; then
    firefox_profile "$APP_DIR/firefox-app"
    firefox --profile "$APP_DIR/firefox-app" --class mtga-stats --name mtga-stats --new-window "$URL" >/dev/null 2>&1 & return 0
  fi
  if command -v flatpak >/dev/null 2>&1 && flatpak info org.mozilla.firefox >/dev/null 2>&1; then
    # Das Flatpak darf nur in seinen eigenen Ordner unter ~/.var/app schauen
    local P="$HOME/.var/app/org.mozilla.firefox/mtga-stats-app"
    firefox_profile "$P"
    flatpak run org.mozilla.firefox --profile "$P" --class mtga-stats --name mtga-stats --new-window "$URL" >/dev/null 2>&1 & return 0
  fi
  # 3. sonst der Standardbrowser
  xdg-open "$URL" >/dev/null 2>&1 &
}
case "${1:-status}" in
  run) cd "$ROOT"; exec "$NODE" src/watch.js ;;
  start)
    if managed; then echo "Watcher läuft als Hintergrunddienst."; exit 0; fi
    if running; then echo "Watcher läuft bereits (PID $(cat "$PIDFILE"))."; exit 0; fi
    cd "$ROOT"
    nohup "$NODE" src/watch.js >> "$APP_DIR/watcher.out.log" 2>&1 &
    echo $! > "$PIDFILE"; echo "Watcher gestartet (PID $!). Dashboard: $URL" ;;
  stop)
    if [ "$OS" = "Darwin" ] && managed; then launchctl bootout "gui/$(id -u)/de.mtga-stats.watcher" 2>/dev/null || brew services stop mtga-stats; echo "Hintergrunddienst gestoppt."; exit 0; fi
    if [ "$OS" != "Darwin" ] && managed; then systemctl --user stop mtga-stats.service; echo "Dienst gestoppt."; exit 0; fi
    if running; then kill "$(cat "$PIDFILE")" && rm -f "$PIDFILE" && echo "Watcher gestoppt."; else echo "Watcher läuft nicht."; fi ;;
  restart) "$0" stop || true; sleep 1; if [ "$OS" = "Darwin" ]; then launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/de.mtga-stats.watcher.plist" 2>/dev/null || "$0" start; else systemctl --user start mtga-stats.service 2>/dev/null || "$0" start; fi ;;
  app)
    # Vordergrund samt Dashboard – für das Flatpak, das mit seinem Startprozess endet. Läuft schon ein Watcher, nur öffnen.
    if up; then open_url; exit 0; fi
    cd "$ROOT"
    ( wait_up 60 && open_url ) &
    exec "$NODE" src/watch.js ;;
  status)
    if managed || running || up; then echo "Watcher: läuft · Dashboard $URL"; else echo "Watcher: gestoppt"; fi
    echo "Einstellungen: $MTGA_STATS_CONFIG · Daten: $LOGDIR"
    "$NODE" -e "const p=require(process.env.MTGA_ROOT+'/src/paths.js'); console.log('Arena: '+(p.mtgaPid()?'läuft':'nicht gestartet')+' · Log: '+p.findLogFile()+' · Spieldaten: '+(p.findDataDir()||'nicht gefunden'))" ;;
  dashboard)
    if ! up; then
      if ! managed && ! running; then "$0" start; fi
      wait_up 30 || echo "Das Dashboard antwortet noch nicht – Protokoll: $0 log"
    fi
    open_url ;;
  log) tail -n 40 -f "$LOGDIR/watch.log" ;;
  account) cd "$ROOT" && "$NODE" src/account.js --save ;;
  update)
    # Neuester Stand von GitHub (über die Website), in denselben Ordner; Einstellungen und Daten bleiben
    if [ ! -w "$ROOT" ] || [ ! -f "$ROOT/install.sh" ]; then
      echo "Dieser Ordner lässt sich nicht selbst aktualisieren ($ROOT). Flatpak: flatpak update · Homebrew: brew upgrade mtga-stats" >&2; exit 1
    fi
    SITE="${MTGA_STATS_SITE:-https://mtga.a16.be}"
    command -v curl >/dev/null 2>&1 || { echo "Für das Update wird curl gebraucht." >&2; exit 1; }
    curl -fsSL --retry 3 --retry-delay 2 "$SITE/install.sh" -o "$APP_DIR/update.sh"
    MTGA_STATS_DIR="$ROOT" exec bash "$APP_DIR/update.sh" "${@:2}" ;;
  *) echo "Verwendung: mtga-stats start|stop|restart|run|app|status|dashboard|log|account|update"; exit 1 ;;
esac
